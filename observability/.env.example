# Copy this file to observability/.env and fill in your Honeycomb key.
#   cp observability/.env.example observability/.env
#
# Get a key from https://ui.honeycomb.io/  ->  Account / Environment settings ->
# API Keys. The free tier is plenty for the thesis.
#
# observability/.env is git-ignored, so your key never lands in the repo.

HONEYCOMB_API_KEY=your_honeycomb_ingest_key_here
